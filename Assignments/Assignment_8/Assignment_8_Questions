3) Write the code you would use to model the data found in 
“/Data/non_linear_relationship.csv” with a linear model 
(there are a few ways of doing this)

library(tidyverse)

nl_data <- read.csv("../../Data/non_linear_relationship.csv")

mod_poly <- lm(response ~ predictor + I(predictor^2), data = nl_data)
summary(mod_poly)

library(splines)
mod_spline <- lm(response ~ ns(predictor, df = 4), data = nl_data)
summary(mod_spline)

ggplot(nl_data, aes(x = predictor, y = response)) +
  geom_point() +
  geom_smooth(method = "lm", formula = y ~ poly(x, 2), se = TRUE, color = "blue") +
  ggtitle("Non-linear Modeling Example")

